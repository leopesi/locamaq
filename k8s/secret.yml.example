# LocaMaq — Kubernetes Secret Template
# NÃO commitar este arquivo com valores reais!
# Use: kubectl create secret generic locamaq-env --from-env-file=.env -n locamaq

apiVersion: v1
kind: Secret
metadata:
  name: locamaq-env
  namespace: locamaq
type: Opaque
stringData:
  SECRET_KEY: "CHANGE_ME_USE_A_STRONG_RANDOM_KEY_WITH_50_CHARS"
  DEBUG: "False"
  ALLOWED_HOSTS: "locamaq.seudominio.com"
  DJANGO_SETTINGS_MODULE: "config.settings.prod"
  EVOLUTION_API_URL: "http://evolution-api:8080"
  EVOLUTION_API_KEY: "your-api-key"
  EVOLUTION_INSTANCE: "locamaq"
